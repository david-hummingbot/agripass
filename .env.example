APP_ENV=local
APP_URL=http://localhost:8080
APP_PORT=8080
# HTTPS listener for phone scanners (cameras need HTTPS). Add this machine's LAN IP or hostname,
# comma-separated, so the self-signed certificate covers it, then open https://<ip>:8443/scanner/
APP_TLS_PORT=8443
APP_TLS_HOSTS=
# Used to sign QR tokens. Generate with: openssl rand -hex 32
APP_KEY=change-me

DB_HOST=db
DB_PORT=3306
DB_HOST_PORT=3307
DB_DATABASE=agripass
DB_USERNAME=agripass
DB_PASSWORD=agripass
DB_ROOT_PASSWORD=root

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@agripass.local
MAIL_FROM_NAME="PAA AgriPass"
# For a real SMTP provider, also set MAIL_USERNAME, MAIL_PASSWORD and MAIL_ENCRYPTION (tls or ssl).
MAILPIT_UI_PORT=8025

PMA_PORT=8081

ADMIN_EMAIL=admin@paa.local
ADMIN_PASSWORD=admin12345
